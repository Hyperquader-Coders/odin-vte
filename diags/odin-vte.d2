# odin-vte: its place in the binding graph
# Render:  d2 diags/odin-vte.d2 diags/odin-vte.svg

direction: down

title: "odin-vte" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-vte\nVTE 0.84.1" {
  style.fill: "#eef6ff"
}
lib: "vte-2.91-gtk4 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"vte:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection vte
this -> lib: foreign import
